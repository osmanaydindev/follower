# Copy to .env on the server and fill in. .env is never committed; chmod 600 it.
#   cp .env.example .env && chmod 600 .env

# ---- web ----
# Host port the web container is published on (127.0.0.1 only; nginx proxies to
# it). Check `sudo ss -ltnp` before changing — the VPS runs several stacks.
WEB_PORT=3006

# Public origin, once there is a domain. Used for canonical URLs and OpenGraph.
SITE_URL=

# Turn on the moment TLS is in place. Before that a Secure cookie is never sent
# back over plain http and the user appears signed out forever.
COOKIE_SECURE=false

# ---- backend ----
# mock = deterministic fake data, zero Instagram contact (the safe default).
# real = the instagrapi sidecar, i.e. live requests on the user's own account.
IG_PROVIDER=mock

# ---- sidecar guard rails ----
# These exist because live testing showed that requests sent to an already
# flagged account deepen the flag. Raising them is how you get an account
# checkpointed.
IG_COOLDOWN_MINUTES=60
IG_LOGIN_COOLDOWN_MINUTES=3
IG_REQUESTS_PER_HOUR=200
IG_LIST_CACHE_MINUTES=30
IG_PAGES_PER_REST=10

# One sticky exit IP per account. Format is the sidecar's own (see
# ig-sidecar/main.py); leave empty to use the server's own address.
# Note: a commercial VPN exit was tested and rejected by Instagram outright —
# residential or mobile only, and it must not change mid-session.
IG_PROXIES=
IG_PROXY=
