# Follower — nginx site config.
#
# Copy to /etc/nginx/sites-available/<domain>, replace <domain>, symlink into
# sites-enabled, then:
#
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d <domain> -d www.<domain>
#
# Afterwards set COOKIE_SECURE=true in .env and `docker compose up -d web`.
#
# Rules for this server, which hosts several sites behind one nginx:
#   - never use `default_server`, never touch sites-enabled/default
#   - never edit another site's config
#   - after reloading, curl every other site to confirm it is still up
#
# certbot rewrites this file when it adds TLS; that is expected.

server {
    listen 80;
    listen [::]:80;
    server_name <domain> www.<domain>;

    # Instagram data; keep it out of any shared cache.
    add_header Cache-Control "no-store" always;

    # POST /api/ig/ingest carries both collected lists. A 10k-follower account
    # is a few megabytes of JSON.
    client_max_body_size 16m;

    location / {
        proxy_pass http://127.0.0.1:3006;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
    }

    # Load-bearing. Fetching the two follower lists legitimately takes minutes:
    # the sidecar paginates with deliberate pauses so the account does not get
    # flagged. nginx's 60-second default would cut that off mid-fetch and the
    # user would see a failed analysis for no reason.
    location /api/ {
        proxy_pass http://127.0.0.1:3006;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout    900s;
        proxy_send_timeout    900s;
        proxy_connect_timeout 15s;
        proxy_buffering       off;
    }

    # Build output is content-hashed and safe to cache hard.
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3006;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }
}
